#!/bin/sh
set -e

# Only run composer install if vendor is missing or stale
if [ ! -f vendor/autoload.php ]; then
    echo "[start] Running composer install..."
    composer install --no-interaction --prefer-dist --optimize-autoloader
else
    echo "[start] vendor/ exists, skipping composer install"
fi

chown -R www-data:www-data storage bootstrap/cache 2>/dev/null || true

# Only generate key if APP_KEY is not set in the environment
if [ -z "$APP_KEY" ]; then
    echo "[start] Generating app key..."
    php artisan key:generate --force
else
    echo "[start] APP_KEY already set, skipping key:generate"
fi

php artisan optimize:clear
php artisan storage:link --force 2>/dev/null || true

echo "[start] Starting Laravel development server..."
php artisan serve --host 0.0.0.0