services:
  eppid-nginx-service:
    container_name: eppid-nginx-service
    image: nginx:stable-alpine
    depends_on:
      - eppid-master-service
      - eppid-user-service
      - eppid-file-service
      - eppid-content-service
    ports:
      - '80:8080'
    volumes:
      - './nginx/app.config.staging:/etc/nginx/conf.d/default.conf'
    networks:
      - default

  eppid-master-service:
    container_name: eppid-master-service
    build: 
      context: ./master-service
      dockerfile: Dockerfile.staging
    volumes:
      - ./master-service:/var/www/html
      - vendor_master_service:/var/www/html/vendor
      - /data/eppid-staging/storage:/var/www/html/storage
      - ./master-service/docker/php/php.ini:/etc/local/etc/php/php.ini
    networks:
      - db-network
      - default

  eppid-user-service:
    container_name: eppid-user-service
    build: 
      context: ./user-service
      dockerfile: Dockerfile.staging
    volumes:
      - ./user-service:/var/www/html
      - vendor_user_service:/var/www/html/vendor
      - /data/eppid-staging:/var/www/html/storage
      - ./user-service/docker/php/php.ini:/etc/local/etc/php/php.ini
    networks:
      - db-network
      - default

  eppid-migration-service:
    container_name: eppid-migration-service
    build: 
      context: ./migration-service
      dockerfile: Dockerfile.staging
    volumes:
      - ./migration-service:/var/www/html
      - vendor_migration_service:/var/www/html/vendor
      - /data/eppid-staging:/var/www/html/storage
      - ./migration-service/docker/php/php.ini:/etc/local/etc/php/php.ini
    networks:
      - db-network
      - default
  
  eppid-file-service:
    container_name: eppid-file-service
    build: 
      context: ./file-service
      dockerfile: Dockerfile.staging
    volumes:
      - ./file-service:/var/www/html
      - vendor_files_service:/var/www/html/vendor
      - /data/eppid-staging:/var/www/html/storage
      - ./file-service/docker/php/php.ini:/etc/local/etc/php/php.ini
    networks:
      - db-network
      - default

  eppid-content-service:
    container_name: eppid-content-service
    build: 
      context: ./content-service
      dockerfile: Dockerfile.staging
    volumes:
      - ./content-service:/var/www/html
      - vendor_content_service:/var/www/html/vendor
      - /data/eppid-staging:/var/www/html/storage
      - ./content-service/docker/php/php.ini:/etc/local/etc/php/php.ini
    networks:
      - db-network
      - default

networks:
    db-network:
      external:
        name: db-network
