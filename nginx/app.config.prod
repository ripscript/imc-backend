server {
    listen 8080;
    server_name localhost;

    proxy_read_timeout 600;
    proxy_connect_timeout 600;
    proxy_send_timeout 600;
    client_max_body_size 500M;

    # Health check
    location /healthy {
        add_header Content-Type "application/json";
        return 200 '{"status": true, "message": "Healthy System nginx E-PPID"}';
    }

    # Mapping ke master-service
    location /master-service/ {
        proxy_pass http://imc--new-engine-master-service:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Mapping ke user-service
    location /user-service/ {
        proxy_pass http://imc--new-engine-user-service:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Mapping ke content-service
    location /file-service/ {
        proxy_pass http://imc--new-engine-file-service:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Mapping ke content-service
    location /content-service/ {
        proxy_pass http://imc--new-engine-content-service:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}
